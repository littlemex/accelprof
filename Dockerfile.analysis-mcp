# Reference image for the accelprof analysis MCP — a sample for running it in a container. The package
# is the source of truth; this image just pip-installs it (with the [mcp] extra) and runs the
# console script. No orchestrator or cloud is assumed by the image itself.
#
# It ships only the builtin 'inventory' analyzer; layer tool-specific analyzers (nsys, neuron) on
# top by building FROM this pattern and adding the tool (see Dockerfile.analysis-mcp-nsys), then
# registering a CommandAnalyzer via MCP_ANALYZERS — kept out of the base so it stays small and
# tool-agnostic.
FROM python:3.12-slim
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir .[mcp]
RUN useradd -u 1000 -m mcp && chown -R mcp /app
USER mcp
ENV MCP_PORT=8080
EXPOSE 8080
CMD ["accelprof-analysis-mcp"]
