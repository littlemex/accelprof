# CPU-only AWS Neuron compiler image — produces a .neff WITHOUT a Trainium/Inferentia device.
#
# Why this exists: torch_neuronx.trace() cannot compile CPU-only (it acquires an xla_device and
# fails with "No neuron device available"). But the neuronx-cc COMPILER is CPU-only, and it accepts
# an XLA HLO. So the working device-less route (see examples/neuron_cpu_compile.py) is:
#   PJRT_DEVICE=CPU  ->  lower the model to HLO on the CPU XLA backend (which has a device)
#   ->  neuronx-cc compile --framework XLA --target trn2 <hlo.pb> -o model.neff
# Verified end-to-end (in-cluster BuildKit build + a Job on a CPU node): "Compiler status PASS".
#
# The three system libs below are exactly what made import + compile work CPU-only:
#   aws-neuronx-runtime-lib  -> libnrt.so.1  (torch_neuronx dlopens it at import, even for compile)
#   libpython3.10            -> libpython3.10.so.1.0 (torch_xla's _XLAC C-extension links it)
#   libarchive13             -> libarchive.so.13 (neuronx-cc's walrus_driver backend needs it)
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip libpython3.10 libarchive13 g++ gnupg2 ca-certificates wget && rm -rf /var/lib/apt/lists/*
RUN echo "deb https://apt.repos.neuron.amazonaws.com jammy main" > /etc/apt/sources.list.d/neuron.list \
 && wget -qO- https://apt.repos.neuron.amazonaws.com/GPG-PUB-KEY-AMAZON-AWS-NEURON.PUB | gpg --dearmor > /usr/share/keyrings/neuron.gpg \
 && sed -i 's#^deb #deb [signed-by=/usr/share/keyrings/neuron.gpg] #' /etc/apt/sources.list.d/neuron.list \
 && apt-get update && apt-get install -y --no-install-recommends aws-neuronx-runtime-lib aws-neuronx-collectives && rm -rf /var/lib/apt/lists/*
ENV LD_LIBRARY_PATH=/opt/aws/neuron/lib
RUN pip3 install --no-cache-dir --extra-index-url https://pip.repos.neuron.amazonaws.com "neuronx-cc==2.*" "torch-neuronx" "torch==2.5.*" 2>&1 | tail -4
RUN python3 -c "import neuronxcc; print('neuronx-cc', neuronxcc.__version__)"
