# The xprof analysis MCP WITH the NVIDIA Nsight Systems CLI (nsys) layered in, so a deployment can
# register an `nsys stats` CommandAnalyzer (MCP_ANALYZERS) that reads a .nsys-rep and returns advice.
# nsys stats is CPU-runnable (no GPU needed to analyze a captured report). A sample tool-layered
# image; kept separate from the base so the base stays small and tool-agnostic.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends wget gnupg ca-certificates \
    && wget -qO /usr/share/keyrings/nvidia-devtools.asc \
       https://developer.download.nvidia.com/devtools/repos/ubuntu2204/amd64/nvidia.pub \
    && echo "deb [signed-by=/usr/share/keyrings/nvidia-devtools.asc] https://developer.download.nvidia.com/devtools/repos/ubuntu2204/amd64/ /" \
       > /etc/apt/sources.list.d/nvidia-devtools.list \
    && apt-get update && apt-get install -y --no-install-recommends nsight-systems-cli \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir .[mcp]
RUN useradd -u 1000 -m mcp && chown -R mcp /app
USER mcp
ENV MCP_PORT=8080
EXPOSE 8080
CMD ["xprof-analysis-mcp"]
